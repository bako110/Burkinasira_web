# Valeurs par defaut, non secretes, versionnees.
# Surchargez par machine dans .env.local (gitignore) : VITE_API_BASE_URL notamment.

VITE_APP_NAME=BurkinaSira

# ID client OAuth "Web" du projet Google Cloud BurkinaSira.
# Public par nature : Vite l'inline dans le bundle JS livre au navigateur.
# L'ID client "Android" (package + SHA-1) se configure cote Google Cloud
# uniquement, il ne se met pas ici.
VITE_GOOGLE_WEB_CLIENT_ID=404132144095-akp792ll235rfouh3tt6s4roudgepnm8.apps.googleusercontent.com
